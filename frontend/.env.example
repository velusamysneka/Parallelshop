# Dev only: where the Vite dev server proxies /api requests (your local FastAPI).
API_PROXY_TARGET=http://localhost:8080

# Production builds: base URL of the deployed API (no trailing slash). Leave unset in dev to use the proxy.
# Put this in .env.production before `npm run deploy`.
# VITE_API_BASE_URL=https://parallelshop-api-xxxxxxxxxx-el.a.run.app
